{
  "rules": {
    // -----------------------------------------------------------------------
    // Owner UIDs
    //   sKRHXxHf9cgzna8ce9UMdFvHZVZ2  — nguyenvanthanh2210@gmail.com (personal)
    //   BUqnab10ASdHkwAM3HOezLIq6qe2  — owner-irrigation@app.local (test account)
    // Device UID
    //   2GVAabgRrafbeBkfpeagzYnnU9w2  — esp32-irrigation@device.local
    // -----------------------------------------------------------------------

    // Helper: true if the caller is any owner account
    // (Firebase rules don't support functions, so inline the check everywhere)

    // -----------------------------------------------------------------------
    // Existing iot2025 data — personal owner only
    // -----------------------------------------------------------------------
    "iot2025": {
      ".read":  "auth != null && auth.uid === 'sKRHXxHf9cgzna8ce9UMdFvHZVZ2'",
      ".write": "auth != null && auth.uid === 'sKRHXxHf9cgzna8ce9UMdFvHZVZ2'"
    },

    // -----------------------------------------------------------------------
    // Irrigation system
    // -----------------------------------------------------------------------
    "irrigation": {

      // Device heartbeat — ESP32 writes, any owner reads
      "devices": {
        "$device_id": {
          ".read":  "auth != null && (auth.uid === 'sKRHXxHf9cgzna8ce9UMdFvHZVZ2' || auth.uid === 'BUqnab10ASdHkwAM3HOezLIq6qe2')",
          ".write": "auth != null && auth.uid === '2GVAabgRrafbeBkfpeagzYnnU9w2'"
        }
      },

      "zones": {
        "$zone_id": {

          // Zone metadata — any owner reads and writes
          "meta": {
            ".read":  "auth != null && (auth.uid === 'sKRHXxHf9cgzna8ce9UMdFvHZVZ2' || auth.uid === 'BUqnab10ASdHkwAM3HOezLIq6qe2')",
            ".write": "auth != null && (auth.uid === 'sKRHXxHf9cgzna8ce9UMdFvHZVZ2' || auth.uid === 'BUqnab10ASdHkwAM3HOezLIq6qe2')"
          },

          // Sensor data — ESP32 writes, any owner reads
          "sensor": {
            ".read":  "auth != null && (auth.uid === 'sKRHXxHf9cgzna8ce9UMdFvHZVZ2' || auth.uid === 'BUqnab10ASdHkwAM3HOezLIq6qe2')",
            ".write": "auth != null && auth.uid === '2GVAabgRrafbeBkfpeagzYnnU9w2'"
          },

          // Sensor history — ESP32 pushes entries, any owner reads
          "history": {
            ".read":  "auth != null && (auth.uid === 'sKRHXxHf9cgzna8ce9UMdFvHZVZ2' || auth.uid === 'BUqnab10ASdHkwAM3HOezLIq6qe2')",
            ".write": "auth != null && auth.uid === '2GVAabgRrafbeBkfpeagzYnnU9w2'"
          },

          // Valve state — ESP32 writes, any owner reads
          "valve": {
            ".read":  "auth != null && (auth.uid === 'sKRHXxHf9cgzna8ce9UMdFvHZVZ2' || auth.uid === 'BUqnab10ASdHkwAM3HOezLIq6qe2')",
            ".write": "auth != null && auth.uid === '2GVAabgRrafbeBkfpeagzYnnU9w2'"
          },

          // Command — any owner writes, ESP32 reads and clears
          "command": {
            ".read":  "auth != null && auth.uid === '2GVAabgRrafbeBkfpeagzYnnU9w2'",
            ".write": "auth != null && (
              auth.uid === 'sKRHXxHf9cgzna8ce9UMdFvHZVZ2' ||
              auth.uid === 'BUqnab10ASdHkwAM3HOezLIq6qe2' ||
              auth.uid === '2GVAabgRrafbeBkfpeagzYnnU9w2'
            )"
          },

          // Schedule — any owner reads and writes, ESP32 reads
          "schedule": {
            ".read":  "auth != null && (
              auth.uid === 'sKRHXxHf9cgzna8ce9UMdFvHZVZ2' ||
              auth.uid === 'BUqnab10ASdHkwAM3HOezLIq6qe2' ||
              auth.uid === '2GVAabgRrafbeBkfpeagzYnnU9w2'
            )",
            ".write": "auth != null && (auth.uid === 'sKRHXxHf9cgzna8ce9UMdFvHZVZ2' || auth.uid === 'BUqnab10ASdHkwAM3HOezLIq6qe2')"
          }
        }
      }
    },

    // -----------------------------------------------------------------------
    // Deny everything else
    // -----------------------------------------------------------------------
    "$other": {
      ".read":  false,
      ".write": false
    }
  }
}
