#pragma once

// ── Active board selector ─────────────────────────────────────────────────────
// Change this number to switch boards, then re-flash.
#define ACTIVE_BOARD 1

// ── Board 1 ───────────────────────────────────────────────────────────────────
#if ACTIVE_BOARD == 1

  #define DEVICE_ID             "esp32-01"
  #define DEVICE_NAME           "Irrigation Controller 01"
  #define ZONE_1_ID             "balcony"
  #define ZONE_1_NAME           "Balcony"
  #define ZONE_2_ID             "garden"
  #define ZONE_2_NAME           "Garden"
  #define FIRMWARE_VERSION      "1.0.0"
  #define ZONE_1_SENSOR_ENABLED  1
  #define ZONE_2_SENSOR_ENABLED  1

  // Calibration — measure from real hardware before filling in
  #define DRY_RAW_1             3200
  #define WET_RAW_1             1200
  #define DRY_RAW_2             3200
  #define WET_RAW_2             1200

// ── Board 2 ───────────────────────────────────────────────────────────────────
#elif ACTIVE_BOARD == 2

  #define DEVICE_ID             "esp32-02"
  #define DEVICE_NAME           "Irrigation Controller 02"
  #define ZONE_1_ID             "balcony2"
  #define ZONE_1_NAME           "Balcony 2"
  #define ZONE_2_ID             "garden2"
  #define ZONE_2_NAME           "Garden 2"
  #define FIRMWARE_VERSION      "1.0.0"
  #define ZONE_1_SENSOR_ENABLED  1
  #define ZONE_2_SENSOR_ENABLED  1

  // Calibration — measure from real hardware before filling in
  #define DRY_RAW_1             3200
  #define WET_RAW_1             1200
  #define DRY_RAW_2             3200
  #define WET_RAW_2             1200

#else
  #error "Unknown ACTIVE_BOARD value — set to 1 or 2 at the top of config.h"
#endif

// ── Shared — same for all boards ─────────────────────────────────────────────

// Firebase credentials
#define FIREBASE_API_KEY      "your-api-key"
#define FIREBASE_EMAIL        "your-email@example.com"
#define FIREBASE_PASSWORD     "your-password"
#define FIREBASE_DB_URL       "your-project-default-rtdb.region.firebasedatabase.app"

// WiFi credentials — fallback if nothing saved in flash
#define WIFI_SSID             "your-wifi-ssid"
#define WIFI_PASSWORD         "your-wifi-password"

// Site ID — must match the key under irrigation/sites/ in Firebase
#define SITE_ID               "default"

// Set to 1 to print sensitive values in boot log — disable before production
#define DEBUG_PRINT_SECRETS   0

// GPIO pins — same hardware layout on both boards
#define SENSOR_1_PIN          34
#define SENSOR_2_PIN          35
#define RELAY_1_PIN           26
#define RELAY_2_PIN           27

// Safety and timing (milliseconds)
#define MAX_VALVE_MS           180000UL   // 3 minutes
#define SENSOR_INTERVAL_MS     30000UL    // 30 seconds — overridable via PWA
#define HEARTBEAT_INTERVAL_MS  60000UL    // 60 seconds
#define FIREBASE_TIMEOUT_MS    300000UL   // 5 minutes
#define SCHEDULE_RELOAD_MS     300000UL   // reload schedules every 5 minutes

// Timezone offset from UTC in seconds (Vietnam UTC+7 = 25200 | Singapore UTC+8 = 28800 | UTC = 0)
#define TIMEZONE_OFFSET_SEC    25200
