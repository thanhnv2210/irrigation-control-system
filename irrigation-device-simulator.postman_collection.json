    {
      "name": "8. New Device Onboarding — Home 1",
      "description": "Complete step-by-step simulation of onboarding a fresh ESP32 device to a brand-new site.\n\nRun each request IN ORDER. The 'Create site' step captures the new push key into {{new_site_id}} automatically.\n\nAfter completing this folder the PWA will show:\n- 'Home 1' in the site switcher\n- Two zone cards (zone-a, zone-b) with live moisture\n- Device status bar → ONLINE",
      "item": [
        {
          "name": "Step 1 — Owner signs in",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.idToken) {",
                  "  pm.collectionVariables.set('owner_token', res.idToken);",
                  "  pm.test('Owner auth OK', () => pm.expect(res.idToken).to.be.a('string'));",
                  "} else {",
                  "  pm.test('Auth failed', () => pm.expect.fail(JSON.stringify(res)));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{api_key}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"{{owner_pass}}\",\n  \"returnSecureToken\": true\n}"
            }
          }
        },
        {
          "name": "Step 2 — Create new site 'Home 1'",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Site created', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "// Firebase REST POST returns { name: '-OAbc...' } — the new push key",
                  "if (res.name) {",
                  "  pm.collectionVariables.set('new_site_id', res.name);",
                  "  console.log('New site ID:', res.name);",
                  "  pm.test('Site ID captured', () => pm.expect(res.name).to.be.a('string'));",
                  "} else {",
                  "  pm.test('Site ID missing', () => pm.expect.fail(JSON.stringify(res)));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{db_url}}/irrigation/sites.json?auth={{owner_token}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"meta\": {\n    \"name\": \"Home 1\",\n    \"createdAt\": {\".sv\": \"timestamp\"}\n  }\n}"
            }
          }
        },
        {
