        {
          "name": "Step 14 — Verify site structure (owner read)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Site readable by owner', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Site has meta', () => pm.expect(body).to.have.property('meta'));",
                  "pm.test('Site has zones', () => pm.expect(body).to.have.property('zones'));",
                  "pm.test('Site has devices', () => pm.expect(body).to.have.property('devices'));",
                  "console.log('Site name:', body.meta?.name);",
                  "console.log('Zones:', Object.keys(body.zones || {}));",
                  "console.log('Onboarding complete — open the PWA and switch to this site.');"
