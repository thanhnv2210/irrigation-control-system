            }
          }
        },
        {
          "name": "Step 13 — Device checks for pending commands (zone-a)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Command poll OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const action = body ? body.action : null;",
                  "pm.test('No pending command on fresh site', () => pm.expect(action).to.be.null);",
                  "console.log('Zone-a command:', action ?? 'none — safe to proceed');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{db_url}}/irrigation/sites/{{new_site_id}}/zones/zone-a/command.json?auth={{device_token}}"
          }
