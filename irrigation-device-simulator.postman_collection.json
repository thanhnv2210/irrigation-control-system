                  "if (res.idToken) {",
                  "  pm.collectionVariables.set('device_token', res.idToken);",
                  "  pm.test('Device auth OK', () => pm.expect(res.idToken).to.be.a('string'));",
                  "} else {",
                  "  pm.test('Auth failed', () => pm.expect.fail(JSON.stringify(res)));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{api_key}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{device_email}}\",\n  \"password\": \"{{device_pass}}\",\n  \"returnSecureToken\": true\n}"
            }
          }
